# Dhan API Credentials
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_jwt_access_token

# Google Credentials (path to service account JSON file)
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# Google Spreadsheet IDs (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SHEET_ID_MIDCAP=your_midcap_spreadsheet_id
SHEET_ID_RANGE=your_range_100_1000_spreadsheet_id
SHEET_ID_SMALLCAP=your_smallcap_spreadsheet_id
